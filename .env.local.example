# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Resend (contact + brand audit forms)
RESEND_API_KEY=
# Both sender and recipient are required. Sender must use a verified domain.
RESEND_FROM_EMAIL=Alchemy Branding <hello@example.com>
RESEND_TO_EMAIL=hello@example.com
# Optional dedicated audit recipient; falls back to RESEND_TO_EMAIL.
RESEND_AUDIT_TO_EMAIL=

# HubSpot (newsletter signup -> Forms Submissions API)
# All values below are required; missing/invalid values make the route return
# 503 so visitors are never shown an unconfirmed success state.
HUBSPOT_PORTAL_ID=
HUBSPOT_NEWSLETTER_FORM_GUID=
# Data-residency region for the Forms API host: eu1 (default) | na1 | ...
HUBSPOT_FORMS_REGION=eu1
# Records the visitor's opt-in so contacts are logged as subscribed instead of
# "Not Specified". CONSENT_TEXT = wording shown next to the consent checkbox.
# SUBSCRIPTION_ID = numeric subscription type id to opt them into (e.g.
# "Marketing Information").
HUBSPOT_CONSENT_TEXT=
HUBSPOT_NEWSLETTER_SUBSCRIPTION_ID=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-KLKH973

# External services
NEXT_PUBLIC_MOTION_URL=https://app.usemotion.com/meet/dave-morgan/discovery-call
NEXT_PUBLIC_WHATSAPP_NUMBER=447734794779

# Environment flag (production | staging | development)
# Controls robots.txt allow/disallow
NEXT_PUBLIC_ENV=development
